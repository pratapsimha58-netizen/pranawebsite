# Neon Postgres connection string (Neon dashboard -> Connect -> connection string).
# When unset, the app runs with an in-memory waitlist and shows a warning on /admin/waitlist.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Optional. When set, /admin/waitlist requires ?token=... or an x-admin-token header.
# Leave empty in local development to keep the admin page open.
ADMIN_TOKEN=

# Optional. Public base URL used for metadata; defaults to http://localhost:4821.
NEXT_PUBLIC_SITE_URL=http://localhost:4821
